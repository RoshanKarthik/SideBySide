{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidebyside",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The React app is served as static assets by this same Worker; only API and realtime
  // requests run Worker code.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/collab/*", "/assets/runner.worker-*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      // One global instance holds the practice matchmaking queue.
      { "name": "Matchmaker", "class_name": "Matchmaker" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // The production database (Neon), from `wrangler hyperdrive create sidebyside-db`. Local
      // development ignores it and uses CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "id": "d0a115d2e3754d9bad4132662e3acf7b",
    },
  ],
  "vars": {
    // Local development. `pnpm deploy` sets the production URL (apps/server/package.json).
    "PUBLIC_APP_URL": "http://localhost:5173",
    // Comma-separated extra origins allowed to call the API (e.g. a second local hostname).
    "TRUSTED_ORIGINS": "",
    "ALLOW_DEV_LOGIN": "false",
    // AI post-interview reports: "workers-ai" (needs the CLOUDFLARE_ACCOUNT_ID and
    // CLOUDFLARE_AI_TOKEN secrets; with a GROQ_API_KEY secret too, Groq takes over when the
    // Workers AI allowance runs out), "groq" (GROQ_API_KEY only), "sample" (local development
    // only) or "off". Without the secrets, reports stay off.
    "AI_SUMMARY_PROVIDER": "workers-ai",
    // Workers AI model id; empty uses the default (see src/ai/provider.ts).
    "AI_MODEL": "",
    // Groq model id for the fallback; empty uses the default.
    "GROQ_MODEL": "",
    // Email sign-in links go out through this SMTP server (a Gmail account by default) once the
    // SMTP_USER and SMTP_PASSWORD (a Gmail App Password) secrets are set.
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    // Java, C, C++ and Go run on Wandbox (wandbox.org, free and public): "wandbox" or "off".
    "REMOTE_EXECUTION": "wandbox",
  },
  // Hourly retention cleanup: deletes rooms past their `delete_after` date (src/jobs/retention.ts).
  "triggers": { "crons": ["30 * * * *"] },
  "observability": { "enabled": true },
  "send_metrics": false,
}
