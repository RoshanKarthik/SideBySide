# Copy to .dev.vars for `pnpm dev`. Never commit .dev.vars.
BETTER_AUTH_SECRET=replace-with-32+-random-characters
GUEST_TOKEN_SECRET=replace-with-another-32+-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Enables email + password sign-in for local testing only. Keep false in production.
ALLOW_DEV_LOGIN=true
# Extra local hostnames (separate cookies) for testing a guest join next to a signed-in tab.
TRUSTED_ORIGINS=http://127.0.0.1:5173,http://guest.localhost:5173
# AI post-interview reports. "sample" shows fixed sample reports for trying the pages locally;
# "workers-ai" calls Cloudflare Workers AI (free tier) with an account id and an API token
# that has the "Workers AI: Read" permission.
AI_SUMMARY_PROVIDER=sample
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional: Groq (console.groq.com, free key) takes over when Workers AI fails.
GROQ_API_KEY=
