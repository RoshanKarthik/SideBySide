# Copy to .env (never commit it). Used by migrations and `pnpm dev`.

# Neon "direct" connection string for your development branch (Neon dashboard → Connect).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/sidebyside?sslmode=require

# What `wrangler dev` uses in place of Hyperdrive locally; usually the same as DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@ep-xxxx.region.aws.neon.tech/sidebyside?sslmode=require
